diff --git a/package/HcMatchfinder.roc b/package/HcMatchfinder.roc
index 484c6a8..398fd1e 100644
--- a/package/HcMatchfinder.roc
+++ b/package/HcMatchfinder.roc
@@ -38,10 +38,18 @@ HcMatchfinder := [].{
 	hash4_size : U64
 	hash4_size = 65536
 
-	## The three tables live in one list: the chain links first (one window
-	## long, indexed by position), then the length-3 heads, then the length-4
-	## heads. One list crosses each call and each loop as three words of
-	## live state instead of nine, and is retained and released once.
+	## The lazy parser keeps the chain links first, since its deeper searches
+	## repeatedly follow them. The greedy parser instead puts the length-4
+	## heads first to save address calculations while inserting skipped bytes.
+	## Both layouts keep all three tables in one unique allocation.
+	Layout : { next_base : U64, hash3_base : U64, hash4_base : U64 }
+
+	default_layout : Layout
+	default_layout = { next_base: 0, hash3_base: 32768, hash4_base: 65536 }
+
+	greedy_layout : Layout
+	greedy_layout = { next_base: 98304, hash3_base: 65536, hash4_base: 0 }
