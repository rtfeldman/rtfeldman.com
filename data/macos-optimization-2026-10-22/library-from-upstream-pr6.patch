new file mode 100644
index 0000000..63de4fd
--- /dev/null
+++ b/benchmark/echo-clock/example.roc
@@ -0,0 +1,22 @@
+app [main!] {
+	deflate: "../../package/main.roc",
+	pf: platform "main.roc",
+}
+
+import pf.Host exposing [echo!, now!]
+import deflate.Deflate
+import "../../README.md" as input : List(U8)
+
+main! = |seed| {
+	# A runtime level keeps this example's compression from being precomputed.
+	level = Deflate.Level.from_u64(1 + seed % 12) ?? 6
+	buf = List.with_capacity(Deflate.compress_bound(input.len()))
+	start = now!()
+	compressed = Deflate.compress_into(input, level, buf)
+	elapsed = now!() - start
+	decoded = Deflate.decompress(compressed) ?? []
+	if decoded != input {
+		crash "round-trip failed"
+	}
+	echo!("${input.len().to_str()} bytes -> ${compressed.len().to_str()} bytes in ${elapsed.to_str()} ns")
+}
diff --git a/benchmark/echo-clock/host-test.c b/benchmark/echo-clock/host-test.c
new file mode 100644
index 0000000..665d3f0
--- /dev/null
+++ b/benchmark/echo-clock/host-test.c
@@ -0,0 +1,69 @@
+#define _POSIX_C_SOURCE 200809L
+#include "mimalloc.h"
+#include <assert.h>
+#include <stdint.h>
+#include <string.h>
+
+/* Count actual releases without changing the allocator under test. */
+static size_t frees;
+static void counted_free(void *ptr) { frees++; mi_free(ptr); }
+#define mi_free counted_free
+#define main platform_main
+#include "host.c"
+#undef main
+#undef mi_free
+
+void roc_main(uint64_t argument) { (void)argument; }
+
+int main(void) {
+    for (size_t alignment = 1; alignment <= 256; alignment *= 2) {
+        uint8_t *p = roc_alloc(37, alignment);
+        assert((uintptr_t)p % alignment == 0);
+        assert(mi_is_in_heap_region(p));
+        memset(p, 0x5a, 37);
+        p = roc_realloc(p, 4096, alignment);
+        assert((uintptr_t)p % alignment == 0);
+        for (size_t i = 0; i < 37; i++) assert(p[i] == 0x5a);
+        p = roc_realloc(p, 7, alignment);
+        assert((uintptr_t)p % alignment == 0);
+        for (size_t i = 0; i < 7; i++) assert(p[i] == 0x5a);
+        p = roc_realloc(p, 0, alignment);
+        assert(p != NULL);
+        roc_dealloc(p, alignment);
+        p = roc_alloc(0, alignment);
+        assert(p != NULL);
+        roc_dealloc(p, alignment);
+    }
+    size_t before = frees;
+    RocStr small = {0};
+    memcpy(&small, "a\0b", 3);
+    ((uint8_t *)&small)[sizeof(small) - 1] = 0x83;
+    roc_echo(small);
+    assert(frees == before);
+
+    /* A static long string must never be released. */
+    static struct { size_t rc; uint8_t bytes[32]; } constant = {0, "abcdefghijklmnopqrstuvwxyz"};
+    roc_echo((RocStr){.bytes = constant.bytes, .length = 26});
+    assert(constant.rc == 0 && frees == before);
+
+    /* Two owned references, the second a slice: release exactly once, using
+     * the original allocation rather than the slice's visible start. */
+    size_t *rc = roc_alloc(sizeof(size_t) + 26, _Alignof(size_t));
+    *rc = 2;
+    uint8_t *bytes = (uint8_t *)(rc + 1);
+    memcpy(bytes, constant.bytes, 26);
+    roc_echo((RocStr){.bytes = bytes, .capacity_or_alloc_ptr = 26 << 1, .length = 26});
+    assert(*rc == 1 && frees == before);
+    roc_echo((RocStr){.bytes = bytes + 2, .capacity_or_alloc_ptr = (uintptr_t)bytes | 1, .length = 24});
+    assert(frees == before + 1);
+
+    uint64_t first = roc_now(), previous = first;
+    for (size_t i = 0; i < 10000; i++) {
+        uint64_t next = roc_now();
+        assert(next >= previous);
+        previous = next;
+    }
+    assert(previous > first);
+    fprintf(stderr, "PASS allocation, echo ownership, monotonic clock\n");
+    return 0;
+}
diff --git a/benchmark/echo-clock/host.c b/benchmark/echo-clock/host.c
new file mode 100644
index 0000000..09c3967
--- /dev/null
+++ b/benchmark/echo-clock/host.c
@@ -0,0 +1,90 @@
+#define _POSIX_C_SOURCE 200809L
+#include "roc_platform_abi.h"
+#include "mimalloc.h"
+
+#include <errno.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+
+static _Noreturn void fail(const char *message) {
+    fprintf(stderr, "echo-clock: %s\n", message);
+    exit(1);
+}
+
+/* Link mimalloc directly: no libc allocator or preload dependency. */
+void *roc_alloc(size_t length, size_t alignment) {
+    void *ptr = alignment <= _Alignof(max_align_t)
+        ? mi_malloc(length ? length : 1)
+        : mi_malloc_aligned(length ? length : 1, alignment);
+    if (!ptr) fail("out of memory");
+    return ptr;
+}
+
+void roc_dealloc(void *ptr, size_t alignment) {
+    (void)alignment;
+    mi_free(ptr);
+}
+
+void *roc_realloc(void *ptr, size_t length, size_t alignment) {
+    void *result = alignment <= _Alignof(max_align_t)
+        ? mi_realloc(ptr, length ? length : 1)
+        : mi_realloc_aligned(ptr, length ? length : 1, alignment);
+    if (!result) fail("out of memory");
+    return result;
+}
+
+/* Hosted calls own their Roc arguments. Heap strings, including seamless
+ * slices, must release that reference after echo; static strings have rc=0. */
+void roc_echo(RocStr str) {
+    const uint8_t *inline_bytes = (const uint8_t *)&str;
+    bool small = (inline_bytes[sizeof(str) - 1] & 0x80) != 0;
+    size_t length = small ? inline_bytes[sizeof(str) - 1] & 0x7f : str.length;
+    const uint8_t *bytes = small ? inline_bytes : str.bytes;
+    if ((length && fwrite(bytes, 1, length, stdout) != length) ||
+        fputc('\n', stdout) == EOF) fail("stdout write failed");
+    if (!small && str.bytes) {
+        uint8_t *allocation = (str.capacity_or_alloc_ptr & 1)
+            ? (uint8_t *)(str.capacity_or_alloc_ptr & ~(uintptr_t)1) : str.bytes;
+        size_t *rc = (size_t *)allocation - 1;
+        if (*rc != 0 && --*rc == 0) roc_dealloc(rc, _Alignof(size_t));
+    }
+}
+
+uint64_t roc_now(void) {
+    struct timespec ts;
+    if (clock_gettime(CLOCK_MONOTONIC, &ts) != 0) fail("monotonic clock failed");
+    return (uint64_t)ts.tv_sec * UINT64_C(1000000000) + (uint64_t)ts.tv_nsec;
+}
+
+void roc_dbg(const uint8_t *bytes, size_t length) {
+    fwrite(bytes, 1, length, stderr);
+    fputc('\n', stderr);
+}
+
+void roc_expect_failed(const uint8_t *bytes, size_t length) {
+    roc_dbg(bytes, length);
+    exit(1);
+}
+
+void roc_crashed(const uint8_t *bytes, size_t length) {
+    roc_dbg(bytes, length);
+    exit(1);
+}
+
+int main(int argc, char **argv) {
+    uint64_t argument = 0;
+    if (argc > 2) fail("expected at most one unsigned integer argument");
+    if (argc == 2) {
+        char *end;
+        errno = 0;
+        unsigned long long value = strtoull(argv[1], &end, 10);
+        if (errno || !argv[1][0] || *end || argv[1][0] == '-')
+            fail("invalid unsigned integer argument");
+        argument = (uint64_t)value;
+    }
+    roc_main(argument);
+    if (fflush(stdout) == EOF) fail("stdout flush failed");
+    return 0;
+}
